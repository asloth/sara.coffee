---
// A project's full story. Rendered on its own page, and lifted into the dialog over the train.
import { render, type CollectionEntry } from 'astro:content';
import '../styles/project-detail.css';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---

<article class="detail" data-project-detail aria-labelledby="project-title">
  <header>
    <p class="kicker">Work <span aria-hidden="true">· 作品</span> — {d.year}</p>
    <h1 id="project-title">{d.title}</h1>
    <p class="summary">{d.summary}</p>
    {d.placeholder && <p class="ph">Placeholder project: replace in src/content/projects/{project.id}.md</p>}
  </header>
  {d.cover && <img class="cover" src={d.cover} alt="" />}
  <dl class="facts">
    <div><dt>Role</dt><dd>{d.role}</dd></div>
    <div>
      <dt>Stack</dt>
      <dd><ul class="stack">{d.stack.map((s) => <li>{s}</li>)}</ul></dd>
    </div>
  </dl>
  <div class="body"><Content /></div>
  {
    d.links.length > 0 && (
      <ul class="links">
        {d.links.map((l) => (
          <li>
            <a href={l.href} target="_blank" rel="noopener">
              {l.label}
              <span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>
