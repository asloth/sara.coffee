---
// About: a carriage ad poster, cream paper with the station's band of colour.
import { getEntry } from 'astro:content';

const site = (await getEntry('site', 'main'))!.data;
---

<article class="poster" data-placeholder={site.placeholder || undefined}>
  <p class="kicker">About <span aria-hidden="true">· 紹介</span></p>
  <h2 id="about-title">Hi, I'm {site.name}.</h2>
  {site.bio.map((p) => <p>{p}</p>)}
  {site.location && <p class="where">Based in {site.location}</p>}
</article>

<style>
  .poster {
    position: relative;
    padding: 1.6rem 1.8rem 1.4rem;
    background:
      radial-gradient(120% 80% at 100% 0%, rgb(255 255 255 / 0.5), transparent 60%),
      var(--paper);
    color: var(--paper-ink);
    border-radius: 2px;
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.35);
    border-top: 0.5rem solid var(--signal);
  }

  .kicker {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8a4b25;
  }

  h2 {
    margin: 0.3rem 0 0.8rem;
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    font-weight: 900;
    line-height: 1.15;
  }

  p {
    margin: 0 0 0.8rem;
  }

  .where {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    color: #5c5548;
  }
</style>
